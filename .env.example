# Copy to .env locally; never commit real values.
# Prefer a preconfigured rclone remote when one already exists. In that mode,
# leave the S3 credential variables unset; the project never reads or prints
# credentials from the protected rclone configuration.
THESIS_RCLONE_REMOTE=
THESIS_NEMO_ASR_API_ROOT=

# Alternative: ephemeral S3 credentials supplied only through the environment.
S3_ENDPOINT=https://minio.example.invalid
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=asr
S3_PROVIDER=Minio

ASR_API_URL=http://127.0.0.1:8090
ASR_TIMEOUT_SECONDS=3
TEXT_LLM_ENABLED=1
# Exact validated model revision: cdbee75f17c01a7cc42f958dc650907174af0554.
# A local snapshot directory may be supplied here, or linked at
# models/qwen3-4b-instruct-2507, on an offline deployment host.
TEXT_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
TEXT_LLM_PROMPT_PROFILE=qwen4b_v2
PIPER_MODEL=models/piper/fa_IR-mana-medium.onnx
